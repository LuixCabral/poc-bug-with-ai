# ─── OpenRouter (LLM dos agentes) ────────────────────────────────────────────
# Gere sua chave em: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key

# ─── Jira ────────────────────────────────────────────────────────────────────
# URL da sua instância Atlassian (sem barra no final)
JIRA_URL=https://your-company.atlassian.net

# E-mail associado à sua conta Atlassian
JIRA_EMAIL=you@example.com

# Gere um API token em:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token

# Chave do projeto Jira onde os bugs serão criados (ex: PROJ, DEV, QA)
JIRA_PROJECT_KEY=PROJ

# ─── PostgreSQL (histórico de sessões da API) ─────────────────────────────────
# Driver assíncrono psycopg v3. Crie o banco antes de iniciar a API.
# Exemplo local com Docker:
#   docker run -d --name bug-reporter-pg \
#     -e POSTGRES_USER=user -e POSTGRES_PASSWORD=password \
#     -e POSTGRES_DB=bug_reporter -p 5432:5432 postgres:16-alpine
DATABASE_URL=postgresql+psycopg_async://user:password@localhost:5432/bug_reporter

# ─── Notion ───────────────────────────────────────────────────────────────────
# Token de integração da API do Notion.
# Crie uma integração em: https://www.notion.so/my-integrations
# Depois compartilhe as páginas/bancos de dados relevantes com a integração.
NOTION_API_TOKEN=secret_your-notion-integration-token

# (Opcional) ID da página raiz da documentação do Agenda Vix (Admin).
# Quando definido, o DocsAgent pode chamar list_child_pages() sem page_id
# para navegar na árvore de documentação a partir da raiz.
# Você encontra o ID na URL: notion.so/<workspace>/<titulo-da-pagina>-<PAGE_ID>
NOTION_ROOT_PAGE_ID=your-root-page-id-here
